# EmailJS credentials for the sponsor inquiry form.
# Copy this file to ".env" and replace the placeholder values.
# Get these from your free account at https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# Sponsor payment display configuration. QR URLs can point to files in /public
# or to hosted image URLs for the team's official payment QR codes.
VITE_ZELLE_HANDLE=YOUR_ZELLE_EMAIL_OR_PHONE
VITE_ZELLE_QR_URL=/zelle-qr.png
VITE_CASHAPP_HANDLE=$YOUR_CASHAPP_HANDLE
VITE_CASHAPP_QR_URL=/cashapp-qr.png
VITE_VENMO_HANDLE=@YOUR_VENMO_HANDLE
VITE_VENMO_QR_URL=/venmo-qr.png

# Optional fixed Stripe Payment Link fallback. The preferred card flow uses
# the Netlify function and STRIPE_SECRET_KEY below for the selected amount.
VITE_STRIPE_PAYMENT_LINK=

# Netlify server-side secret. Never expose this as a VITE_ variable.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only
